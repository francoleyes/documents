<odoo>
    <record id="view_documents_webhook_queue_list" model="ir.ui.view">
        <field name="name">documents.webhook.queue.list</field>
        <field name="model">documents.webhook.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="document_id" />
                <field name="user_id" />
                <field name="action" />
                <field name="webhook_url" />
                <field name="state" />
                <field name="try_count" />
                <field name="last_try_date" />
                <field name="last_error" />
            </list>
        </field>
    </record>

    <record id="view_documents_webhook_queue_form" model="ir.ui.view">
        <field name="name">documents.webhook.queue.form</field>
        <field name="model">documents.webhook.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_set_pending"
                        type="object"
                        string="Set to pending"
                        class="oe_highlight"
                        groups="documents.group_documents_manager"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="document_id" readonly="1" />
                        <field name="user_id" readonly="1" />
                        <field name="action" readonly="1" />
                        <field name="webhook_url" readonly="1" />
                        <field name="try_count" readonly="1" />
                        <field name="last_try_date" readonly="1" />
                        <field name="last_error" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_documents_webhook_queue_search" model="ir.ui.view">
        <field name="name">documents.webhook.queue.search</field>
        <field name="model">documents.webhook.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_id" />
                <field name="user_id" />
                <field name="state" />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('state','=','pending')]"
                />
                <filter name="error" string="Error" domain="[('state','=','error')]" />
                <filter name="done" string="Done" domain="[('state','=','done')]" />
                <separator />
                <filter
                    name="action_create"
                    string="Create"
                    domain="[('action','=','create')]"
                />
                <filter
                    name="action_unlink"
                    string="Unlink"
                    domain="[('action','=','unlink')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_action"
                        string="Action"
                        context="{'group_by': 'action'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_documents_webhook_queue" model="ir.actions.act_window">
        <field name="name">Webhook Queue</field>
        <field name="res_model">documents.webhook.queue</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_documents_webhook_queue_list" />
        <field name="search_view_id" ref="view_documents_webhook_queue_search" />
        <field
            name="context"
        >{"search_default_pending": 1, "search_default_error": 1}</field>
        <field name="help" type="html">
            <p>Monitor and manage webhook queue events for documents.</p>
        </field>
    </record>

    <menuitem
        id="menu_documents_webhook_queue"
        name="Webhook Queue"
        parent="documents.menu_root"
        action="action_documents_webhook_queue"
        groups="base.group_no_one"
        sequence="5"
    />
</odoo>
